# Copy to .env.local for local dev, and set these in Vercel → Project → Settings → Environment Variables.
# Without RESEND_API_KEY the /api/contact route just logs submissions (still returns success),
# which is fine for previewing the UI.

# Resend (https://resend.com) — transactional email
RESEND_API_KEY=

# Inbox that form submissions are delivered to
CONTACT_TO=connect@agriwiseglobal.com

# Verified sender. Until your domain is verified in Resend, use: "AgriWise Global <onboarding@resend.dev>"
CONTACT_FROM="AgriWise Global <onboarding@resend.dev>"
